{
  "name": "feecatalog",
  "version": "1.0.0",
  "description": "This is a backend repository that manages the Fee Catalog of medical colleges.",
  "main": "dist/server.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
